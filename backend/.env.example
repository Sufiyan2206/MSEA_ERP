# Copy to .env (never commit .env). docker-compose and gunicorn read these.
MSEA_ENV=production
SECRET_KEY=replace-with-64-random-chars
JWT_SECRET=replace-with-another-64-random-chars
JWT_EXPIRES_HOURS=10
# MySQL (OCI MySQL HeatWave DB System private IP or local docker)
DATABASE_URL=mysql+pymysql://msea:msea@127.0.0.1:3306/msea?charset=utf8mb4
CORS_ORIGINS=https://erp.msea.example.com
TIMEZONE=Asia/Kolkata
ACADEMIC_YEAR=2026-27
# Only ONE process must run the scheduler (see docker-compose: scheduler service)
SCHEDULER_ENABLED=0
GAP_SCAN_CRON_HOUR=6
DAILY_TARGET_PCT=80
ATTENDANCE_MIN_PCT=75
UPLOAD_DIR=/var/msea/uploads
OBJECT_STORAGE_ENDPOINT=https://<namespace>.compat.objectstorage.ap-hyderabad-1.oraclecloud.com
OBJECT_STORAGE_BUCKET=msea-uploads
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
LOG_LEVEL=INFO
